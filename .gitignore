# Entorno / uv
.venv/
__pycache__/
*.pyc

# Secretos y base de datos local (datos sensibles, RGPD)
.env
data/*.sqlite

# Datos pesados (no versionar audios ni corpus descargados)
data/raw/*
data/processed/*
data/entrenamiento/*          # audios infantiles con consentimiento (dato sensible)
data/lora_infantil/           # adapter LoRA (futuro)
!data/raw/.gitkeep
!data/processed/.gitkeep

# Resultados / notebooks ejecutados
results/*
!results/.gitkeep
.ipynb_checkpoints/

# Sistema
.DS_Store
Thumbs.db

# Backbone ECAPA descargado (no versionar el blob ~80MB)
models/ecapa/
